# The films a few tests need and this repository cannot hold: tens of gigabytes
# each, and every one of them somebody's own library. Copy this file to
# `real_library.toml` beside it (gitignored) and put your own absolute paths in.
# Every test that asks for a key this file does not name, or names at a path that
# is not there, says so on stderr and passes.
#
# `key = "path"`, one per line, `#` comments. See `engine::real_library`.

# 4K HDR10, HEVC Main 10 in Matroska, whose grade lives only in the bitstream
# (MaxCLL/MaxFALL in the HEVC SEI, four code points in the `Colour` element),
# with a fixed-laced 5.1 E-AC-3 track and BCP-47-only subtitle languages.
hevc_4k_hdr = "/path/to/a-4k-hdr10-web-remux.mkv"

# A 720p dual-audio Blu-ray rip: H.264 with its video track header stripped,
# two AAC tracks, no colour tags anywhere in container or SPS.
h264_dual_audio = "/path/to/a-dual-audio-bluray-rip.mkv"

# A 4K Blu-ray x265 remux carrying four PGS subtitle tracks beside one
# `S_TEXT/UTF8` one.
hevc_4k_pgs = "/path/to/a-4k-bluray-remux-with-pgs.mkv"

# A 2160p AV1 HDR10 remux whose main track is 8-channel Opus -- five Opus
# streams, three of them coupled -- beside two 5.1 commentary tracks.
av1_opus_71 = "/path/to/a-2160p-av1-opus-7.1-remux.mkv"

# A feature-length 1080p AV1 remux with a 5.1 Opus track and a cue table: long
# enough to seek an hour into, which is where a Matroska landing goes wrong.
av1_opus_51 = "/path/to/a-1080p-av1-opus-5.1-remux.mkv"

# A feature-length film with a plain AC-3 5.1 track (a BluRay encode or remux):
# the multichannel AC-3 seat's own film witness, seeked and correlated against
# ffmpeg like the Opus and AAC films are.
ac3_51_film = "/path/to/an-ac3-5.1-film.mkv"

# A VP8 WebM (Matroska), odd-height picture: the software VP8 seat's frames
# against ffmpeg's rawvideo.
vp8_webm = "/path/to/a-vp8-webm.webm"

# A VP9 Profile 0 stream in mp4 with an Opus track beside it: the VP9 frames
# against ffmpeg, and the mp4 packet table of both tracks against ffprobe.
vp9_opus_mp4 = "/path/to/a-vp9-opus.mp4"

# A plain mp4 with H.264 and AAC-LC: the packet table against ffprobe, and the
# AAC-LC audio against ffmpeg's decode.
mp4_h264_aac = "/path/to/an-h264-aac-lc.mp4"

# A phone recording: H.264 with full-range (yuvj420p) pixels and AAC-LC at 48 kHz.
mp4_phone_h264 = "/path/to/a-phone-recording.mp4"

# An mp4 with H.264, AAC-LC and a mov_text subtitle track.
mp4_mov_text = "/path/to/an-mp4-with-mov-text.mp4"

# An mp4 with an HE-AAC v1 (SBR) track: the packet table against ffprobe and the
# decode against ffmpeg's f32 output.
mp4_heaac = "/path/to/an-he-aac-v1.mp4"

# A PCM16 WAV: every sample bit-equal to ffmpeg's decode.
wav_pcm16 = "/path/to/a-pcm16.wav"
